<policies>
    <inbound>
        <base />
        <!-- Backend auth sem chave: token da Managed Identity do APIM para o Foundry.
             O dev nunca ve a chave do Foundry; o APIM autentica via MI. -->
        <authentication-managed-identity resource="https://cognitiveservices.azure.com" output-token-variable-name="msi-token" />
        <set-header name="Authorization" exists-action="override">
            <value>@("Bearer " + (string)context.Variables["msi-token"])</value>
        </set-header>
        <!-- Telemetria de tokens consumidos -> Application Insights (custom metric). -->
        <llm-emit-token-metric namespace="genai-gateway">
            <dimension name="Subscription Id" value="@(context.Subscription.Id)" />
            <dimension name="Product Id" value="@(context.Product?.Id ?? &quot;n/a&quot;)" />
            <dimension name="API Id" value="@(context.Api.Id)" />
        </llm-emit-token-metric>
    </inbound>
    <backend>
        <base />
    </backend>
    <outbound>
        <base />
    </outbound>
    <on-error>
        <base />
    </on-error>
</policies>
