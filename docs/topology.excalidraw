      }
    },
    {
      "type": "text",
      "id": "p2a_b",
      "x": 1004,
      "y": 834,
      "width": 538,
      "height": 82,
      "text": "CONSUMO  (o gateway ve):\nTokens Standard (+ reasoning gpt-5 / o-series)\nEmbeddings  ·  DALL-E  ·  Sora\nAgent: code interpreter  ·  Bing grounding",
      "fontSize": 12,
      "fontFamily": 1,
      "strokeColor": "#000000",
      "textAlign": "left",
      "verticalAlign": "top"
    },
    {
      "type": "rectangle",
      "id": "p2b",
      "x": 990,
      "y": 956,
      "width": 560,
      "height": 214,
      "strokeColor": "#d13438",
      "backgroundColor": "#fde7e9",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "roundness": {
        "type": 3
      }
    },
    {
      "type": "text",
      "id": "p2b_b",
      "x": 1004,
      "y": 964,
      "width": 538,
      "height": 159,
      "text": "RELOGIO / parado  (o gateway NAO ve)  -  os assassinos:\nPTU / Provisioned  (por hora)\nFireworks / BYOM GPU  (por hora)\nManaged Compute GPU NC / ND  (24/7)\nHosting de modelo fine-tuned  (hora, idle)\nAI Search S1 / S2  (hora)  ·  Compute instance (hora)\nStorage  ·  Cosmos  ·  Private Endpoint  ·  egress\nIngestao de App Insights / Log Analytics",
      "fontSize": 12,
      "fontFamily": 1,
      "strokeColor": "#000000",
      "textAlign": "left",
      "verticalAlign": "top"
    },
    {
      "type": "rectangle",
      "id": "p3",
      "x": 1590,
