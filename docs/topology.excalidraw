    },
    {
      "type": "text",
      "id": "p2_t",
      "x": 986,
      "y": 780,
      "width": 570,
      "height": 31,
      "text": "O que queima os $500 no Foundry",
      "fontSize": 16,
      "fontFamily": 1,
      "strokeColor": "#000000",
      "textAlign": "left",
      "verticalAlign": "top"
    },
    {
      "type": "rectangle",
